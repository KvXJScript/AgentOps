# Copy to backend/.env and fill in locally. Never commit real values.

# --- Database (matches docker-compose.yml) ---
DATABASE_URL=postgresql+asyncpg://agentops:agentops@localhost:5433/agentops

# --- Chat model ---
# One of: groq | gemini | fake   (fake = deterministic local stub, labelled as such in the UI; for UI dev without a key)
LLM_PROVIDER=groq
# Blank = provider default (groq: openai/gpt-oss-120b, gemini: gemini-3.8-flash, fake: fake-echo)
LLM_MODEL=
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=2048

# Provider credentials — each provider reads ONLY its own variable.
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Chat behaviour ---
CHAT_HISTORY_MESSAGES=20

# --- Documents and RAG ---
MAX_UPLOAD_BYTES=10485760
MAX_PDF_PAGES=500
MAX_DOCUMENT_CHARS=1000000
CHUNK_MAX_CHARS=500
CHUNK_OVERLAP_CHARS=80
# fastembed (local CPU model, downloaded on first use, ~220 MB) | fake (hashed bag-of-words, tests/demos only)
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Blank = fastembed default (system temp dir, may be wiped on reboot)
EMBEDDING_CACHE_DIR=
EMBEDDING_BATCH_SIZE=32
RAG_TOP_K=6
RETRIEVAL_MIN_SCORE=0.35
RAG_CONTEXT_MAX_CHARS=6000

# --- App ---
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# --- Report workflow ---
REPORT_TIMEOUT_S=120
REPORT_TOP_K=8
REPORT_MAX_EVIDENCE_CHARS=12000
REPORT_MAX_CONCURRENT_RUNS=2

# --- MCP local tracker (demo) and approvals ---
MCP_TRACKER_ENABLED=true
# Blank = backend/.data/local-tracker
MCP_TRACKER_DATA_DIR=
# Subset of: list_issues,search_issues,create_issue (nothing else is ever allowed)
MCP_TRACKER_ALLOWED_TOOLS=list_issues,search_issues,create_issue
MCP_TIMEOUT_S=10
MCP_CONNECT_TIMEOUT_S=20
MCP_MAX_OUTPUT_BYTES=256000
PROPOSAL_TTL_S=900
